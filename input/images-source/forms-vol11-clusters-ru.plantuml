@startuml forms-vol11-clusters-ru
hide empty members
skinparam linetype ortho
title Том 11 - восемь подобластей санитарно-эпидемиологического надзора

rectangle "Санитарный надзор за объектами\nи строительством\n246-253, 304-305, 344, 361" as A #F3E8FD
rectangle "Отбор проб и исследование окружающей среды\nвода 254/317/327-331, воздух 332-336, почва 318/337-339,\nпищевые продукты 255-257/345-349/351, физические факторы 310/340-343,\nрадиация 278-280/302-303/353-360,\nполимеры и токсикология 362-364, общие 319/326" as B #F3E8FD
rectangle "Контроль инфекционных\nзаболеваний и вспышек\n258-264, 060, 398" as C #FCE8E6
rectangle "Паразитология, зоонозы и\nопасные патогены\n265-277, 299-301, 306-308, 320, 325,\n379-388, 399, 045-x" as D #FCE8E6
rectangle "Микробиологические лаборатории\n321-324, 350, 365-378" as E #E6F4EA
rectangle "Патогенные биологические агенты\nи работа со штаммами\n281-298" as F #E6F4EA
rectangle "Административное принуждение\n311-316, 352" as G #ECEFF1
rectangle "Дезинфекционные и\nдезинсекционные работы\n309, 389-397" as H #ECEFF1

C --> D : зоонозные / паразитарные очаги
C --> H : дезинфекция очага
B --> E : пробы в лабораторию
D --> F : штаммы в коллекцию
C --> G : нарушения / штрафы

note as N
  Фиолетовый = экологический и санитарный контроль.
  Красный = эпидемиология инфекционных заболеваний.
  Зелёный = лаборатория.
  Серый = принуждение и полевые работы.
  В основном сводные журналы и акты проверок -
  отчётные документы, а не документы по отдельным пациентам.
end note
@enduml
