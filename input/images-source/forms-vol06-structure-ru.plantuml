@startuml forms-vol06-structure-ru
hide circle
hide empty members
skinparam linetype ortho
title Том 6 - пренатальная и неонатальная линии, цвет по типу документа

skinparam class {
  BackgroundColor<<card>> #E8F0FE
  BackgroundColor<<report>> #E6F4EA
  BackgroundColor<<consent>> #FEF7E0
  BackgroundColor<<conclusion>> #F3E8FD
}

package "Пренатальная (мать)" {
  class "159 Карта пренатального\nобследования" as F159 <<card>>
  class "162-164 Протоколы УЗИ\nпо триместрам" as F162 <<report>>
  class "156-157 Заключения\nбиохимического скрининга" as F156 <<conclusion>>
  class "152/153 Информированное\nсогласие" as F152 <<consent>>
  class "155 Отказ от\nинвазивной диагностики" as F155 <<consent>>
  class "166 Процедура\nинвазивной диагностики" as F166 <<report>>
  class "154 Цитогенетический /\nмолекулярный результат" as F154 <<report>>
  class "165/172 Генетическое\nзаключение" as F165 <<conclusion>>
  class "173 Перинатальный\nконсилиум" as F173 <<conclusion>>
}

package "Неонатальная (ребёнок)" {
  class "167 Неонатальный\nскрининг" as F167 <<report>>
  class "168/170 Тандемная МС /\nпотовая проба" as F168 <<report>>
  class "171 Повторный скрининг" as F171 <<report>>
}

package "Регистр наследственных заболеваний" {
  class "158 Амбулаторная карта\nгенетического больного" as F158 <<card>>
  class "160/161 Карты консультаций\nспециалистов" as F160 <<card>>
}

F159 --> F162
F159 --> F156
F156 ..> F152 : при риске
F152 --> F166
F155 ..> F166 : блокирует
F166 --> F154
F154 --> F165
F165 --> F173
F167 --> F168
F167 --> F171
F158 --> F160

legend right
  Синий = карта длительного наблюдения
  Зелёный = протокол
  Жёлтый = согласие / заявление об отказе
  Фиолетовый = заключение
endlegend
@enduml
