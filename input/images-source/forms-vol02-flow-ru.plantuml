@startuml forms-vol02-flow-ru
title Пример процесса - амбулаторное посещение и его возможные последствия
autonumber

actor Пациент as P
participant "Регистратура\nполиклиники" as R
participant "Врач\n(том 2)" as DR
participant "Диагностика и лаборатория\n(том 3)" as DX
participant "Регистр специализированного\nдиспансера (ТБ/онко/нарко)" as REG

P -> R : обращается в поликлинику
R -> R : 024 регистрация амбулаторного посещения\n(024-1..4 ежедневные журналы приёма)
R -> DR : открыта 025 амбулаторная карта
DR -> DX : назначает анализы / визуализацию (том 3)
DX -> DR : результаты возвращены

alt хроническое заболевание подтверждено
  DR -> DR : 030 карта диспансерного наблюдения\n(030-1/030-2/030-4 по заболеванию)
end
alt диагноз подлежит извещению
  DR -> REG : 089 / 090 / 091 извещение о впервые выявленном заболевании
end
alt запрошена справка
  DR -> P : 086 / 043 / 044 медицинская справка (подписана)
end
alt положена прививка
  DR -> DR : 063 карта прививок + 064 журнал
end
@enduml
