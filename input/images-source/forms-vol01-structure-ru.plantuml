@startuml forms-vol01-structure-ru
hide circle
hide empty members
skinparam linetype ortho
title Том 1 - структура документации стационара, цвет по типу документа

skinparam class {
  BackgroundColor<<register>> #ECEFF1
  BackgroundColor<<card>> #E8F0FE
  BackgroundColor<<report>> #E6F4EA
  BackgroundColor<<certificate>> #FEF7E0
}

class "001 Журнал приёма\nи отказов" as F001 <<register>>
class "003 Медицинская карта\nстационарного больного" as F003 <<card>>
class "007 Листок движения\nкоечного фонда" as F007 <<report>>

class "004 Журнал\nанестезий" as F004 <<register>>
class "005 Анестезиологическая\nкарта" as F005 <<report>>
class "008 Журнал\nоперативных вмешательств" as F008 <<register>>
class "006 Динамическое\nнаблюдение в ОРИТ" as F006 <<card>>
class "009 Журнал\nпереливания крови" as F009 <<register>>
class "009-1..009-4\nподформы трансфузии" as F009x <<report>>

class "002 Журнал отделения\nноворождённых" as F002 <<register>>
class "010 Журнал\nзаписи родов" as F010 <<register>>
class "096 История\nродов" as F096 <<card>>
class "097 История развития\nноворождённого" as F097 <<card>>
class "003-1 Карта прерывания\nбеременности" as F003a <<card>>

class "027 Выписка из\nмедицинской карты" as F027 <<report>>
class "066 Статистическая\nкарта выбывшего" as F066 <<card>>
class "103 Регистрация свидетельств\nо рождении" as F103 <<register>>
class "106 Регистрация свидетельств\nо смерти" as F106 <<register>>
class "106-2 Регистрация свидетельств\nо перинатальной смерти" as F106b <<register>>

F001 --> F003 : поступление открывает карту
F003 --> F004
F003 --> F008
F003 --> F006
F003 --> F009
F009 --> F009x
F003 ..> F027 : при выписке
F003 ..> F066 : при выписке
F003 ..> F106 : при смерти

F096 --> F010 : роды
F096 --> F097 : новорождённый
F002 --> F097 : регистрация новорождённого
F096 ..> F103 : свидетельство о рождении
F096 ..> F106b : перинатальная смерть
F096 ..> F003a : прерывание беременности

legend right
  Серый = журнал/реестр (для выборок, не документ)
  Синий = карта длительного наблюдения
  Зелёный = протокол/лист
endlegend
@enduml
