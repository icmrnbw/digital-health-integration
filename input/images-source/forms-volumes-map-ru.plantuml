@startuml forms-volumes-map-ru
hide empty members
left to right direction
skinparam defaultFontSize 9
skinparam ranksep 24
skinparam nodesep 22
skinparam rectangle {
  BackgroundColor<<core>> #E8F0FE
  BackgroundColor<<ops>> #FEF7E0
  BackgroundColor<<public>> #F3E8FD
}

rectangle "1.0 Стационар\n(001-010, 096-097, 103, 106)" as V1 <<core>> [[forms-volume-01-inpatient.html]]
rectangle "2.0 Амбулаторно-поликлиническая помощь\n(023-111)" as V2 <<core>> [[forms-volume-02-ambulatory.html]]
rectangle "3.0 Диагностика и лаборатория\n(011-130)" as V3 <<core>> [[forms-volume-03-diagnostics-laboratory.html]]
rectangle "6.0 Генетика и скрининг\n(152-174)" as V6 <<core>> [[forms-volume-06-genetics-screening.html]]
rectangle "8.0 Служба крови\n(194-222)" as V8 <<core>> [[forms-volume-08-blood-service.html]]
rectangle "7.0 Служба ВИЧ/СПИД\n(175-193)" as V7 <<public>> [[forms-volume-07-hiv.html]]

rectangle "4.0 Аптека и снабжение\n(131-141)" as V4 <<ops>> [[forms-volume-04-pharmacy.html]]
rectangle "5.0 Скорая помощь и санитарная авиация\n(059-3, 142-151)" as V5 <<ops>> [[forms-volume-05-emergency.html]]

rectangle "9.0 Патологическая анатомия\n(223-228)" as V9 <<public>> [[forms-volume-09-pathology.html]]
rectangle "10.0 Судебная медицина\n(229-245)" as V10 <<public>> [[forms-volume-10-forensic.html]]
rectangle "11.0 Санитарно-эпидемиологическая служба\n(246-399, +045-x, 060)" as V11 <<public>> [[forms-volume-11-sanitary-epidemiology.html]]

V2 --> V3 : назначение исследований
V2 --> V6 : пренатальное направление (037-1)
V6 --> V1 : роды
V1 --> V6 : неонатальный скрининг
V8 --> V1 : компоненты крови\nдля переливания (009)
V1 --> V3 : статистика выписки (066)
V2 --> V7 : диспансер ВИЧ (175)
V1 --> V9 : смерть -> вскрытие
V1 --> V10 : смерть -> судмедэкспертиза
V2 --> V11 : экстренное извещение (058, том 3)
V5 --> V1 : экстренная госпитализация

note as N
  Синий = основная клиническая помощь.
  Жёлтый = обеспечение работы и процессов.
  Фиолетовый = общественное здравоохранение и специализированные службы.
end note
@enduml
