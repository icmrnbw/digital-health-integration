@startuml forms-vol06-structure-uz
hide circle
hide empty members
skinparam linetype ortho
title 6-jild - prenatal va neonatal yo'nalishlar, hujjat turi bo'yicha rang

skinparam class {
  BackgroundColor<<card>> #E8F0FE
  BackgroundColor<<report>> #E6F4EA
  BackgroundColor<<consent>> #FEF7E0
  BackgroundColor<<conclusion>> #F3E8FD
}

package "Prenatal (ona)" {
  class "159 Prenatal\ntekshiruv kartasi" as F159 <<card>>
  class "162-164 Trimestrlar bo'yicha\nultratovush bayonnomalari" as F162 <<report>>
  class "156-157 Bioximik\nskrining xulosalari" as F156 <<conclusion>>
  class "152/153 Xabardor qilingan\nrozilik" as F152 <<consent>>
  class "155 Invaziv diagnostikadan\nvoz kechish" as F155 <<consent>>
  class "166 Invaziv\ndiagnostika muolajasi" as F166 <<report>>
  class "154 Sitogenetik /\nmolekulyar natija" as F154 <<report>>
  class "165/172 Genetik\nxulosa" as F165 <<conclusion>>
  class "173 Perinatal\nkonsilium" as F173 <<conclusion>>
}

package "Neonatal (chaqaloq)" {
  class "167 Neonatal\nskrining" as F167 <<report>>
  class "168/170 Tandem MS /\nter sinamasi" as F168 <<report>>
  class "171 Qayta skrining" as F171 <<report>>
}

package "Irsiy kasalliklar registri" {
  class "158 Genetik bemorning\nambulator kartasi" as F158 <<card>>
  class "160/161 Mutaxassis\nkonsultatsiya kartalari" as F160 <<card>>
}

F159 --> F162
F159 --> F156
F156 ..> F152 : xavf bo'lsa
F152 --> F166
F155 ..> F166 : to'sadi
F166 --> F154
F154 --> F165
F165 --> F173
F167 --> F168
F167 --> F171
F158 --> F160

legend right
  Ko'k = uzoq muddatli kuzatuv kartasi
  Yashil = bayonnoma
  Sariq = rozilik / voz kechish arizasi
  Binafsha = xulosa
endlegend
@enduml
