@startuml forms-vol08-flow-ru
title Пример пути - от донора к реципиенту (из тома 8 в том 1)
autonumber

actor Донор as D
participant "Донорское отделение\n(том 8)" as DD
participant "Лаборатория\n(том 8)" as LAB
participant "Производство\nкомпонентов (том 8)" as CP
participant "Отделение больницы\n(том 1)" as WARD

D -> DD : 195 заявление, 196/199 карта донора
DD -> LAB : образец для скрининга
LAB -> LAB : 203/217 группа и Rh, 204 бруцеллёз,\n218 сифилис/HBsAg/ВИЧ, 219 клинические/биохимические
alt донор допущен
  DD -> DD : 201 заготовка цельной крови / 198 аферез
  DD -> CP : единица направлена на переработку
  CP -> CP : 207 компоненты, 208 криопреципитат,\n209 плазма, 210 отмытые эритроциты
  CP -> CP : 205 контроль стерильности
  WARD -> CP : 213 требование на продукты крови
  CP -> WARD : 211 выдача готового продукта
  WARD -> WARD : 009 переливание у постели больного (том 1)
else скрининг положительный
  LAB -> DD : 216 журнал ВИЧ-серопозитивных доноров\n206 утилизация непригодных компонентов
end
@enduml
