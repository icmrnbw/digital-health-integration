@startuml forms-vol06-flow-ru
title Пример процесса - пренатальный скрининг и решение об инвазивной диагностике
autonumber

actor "Беременная\nженщина" as W
participant "Поликлиника\n(том 2)" as PC
participant "Скрининговый центр\n(том 6)" as SC
participant "Новорождённый\n(том 6)" as NB

PC -> SC : 037-1 пренатальное направление
SC -> SC : 159 карта пренатального обследования
SC -> SC : 162-164 протоколы УЗИ по триместрам\n156-157 заключения биохимического скрининга

alt скрининг показывает повышенный риск
  SC -> W : консультирование
  alt женщина даёт согласие
    W -> SC : 152 / 153 информированное согласие
    SC -> SC : 166 процедура инвазивной пренатальной диагностики\n154 цитогенетический / молекулярный результат
    SC -> SC : 165 генетическое заключение, 172 заключение после процедуры\n173 перинатальный консилиум
  else женщина отказывается
    W -> SC : 155 отказ от инвазивной диагностики
  end
end

== после рождения ==
NB -> SC : образец крови из пятки
SC -> SC : 167 неонатальный скрининг (ИРТ, ФКУ, ВГ)
alt отклонение от нормы
  SC -> SC : 168 тандемная масс-спектрометрия / 170 потовая проба / 171 повторный скрининг
end
@enduml
