@startuml forms-journey-inpatient-ru
title Пример пути - хирургический случай в стационаре (тома 1, 3, 8)
autonumber

actor Пациент as P
participant "Приёмное отделение" as ADM
participant "Отделение / операционная\n(том 1)" as WARD
participant "Диагностика и лаборатория\n(том 3)" as DX
participant "Банк крови\n(том 8)" as BB

P -> ADM : поступает на госпитализацию
ADM -> ADM : 001 журнал приёма и отказов
ADM -> WARD : открыта 003 медицинская карта стационарного больного
WARD -> DX : назначает анализы и визуализацию
DX -> WARD : 040-130 результаты анализов, 015 УЗИ, 017 рентген, 020 ЭКГ
WARD -> WARD : 008 журнал оперативных вмешательств\n004 журнал анестезий + 005 анестезиологическая карта

alt требуется переливание
  WARD -> BB : 213 требование на компоненты крови
  BB -> WARD : 211 выдача готового продукта крови
  WARD -> WARD : 009 журнал переливания (+ 009-1..009-4)
end

alt нужна интенсивная терапия
  WARD -> WARD : 006 динамическое наблюдение в ОРИТ
end

WARD -> WARD : обновлён 007 листок движения коечного фонда
alt выписан
  WARD -> WARD : 027 выписка из медицинской карты\n066 статистическая карта выбывшего
else умер
  WARD -> WARD : 106 регистрация свидетельства о смерти
end
@enduml
