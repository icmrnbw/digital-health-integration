@startuml forms-vol09-flow-ru
title Пример пути - патологическая анатомия (том 9)
autonumber

participant "Больница\n(том 1)" as H
participant "Патологоанатомическое\nотделение (том 9)" as PA
participant "Гистологическая\nлаборатория" as HIST

alt умерший пациент
  H -> PA : тело направлено после смерти
  PA -> PA : 223 журнал вскрытых трупов\n224 протокол вскрытия\n228 регистрация тела
  PA -> HIST : 226 секционный материал на гистологию
else хирургический / биопсийный материал
  H -> PA : 225 направление + биопсийный / операционный материал
  PA -> PA : 227 журнал биопсийного и операционного материала
  PA -> HIST : ткань на гистологию
end
HIST -> PA : результат гистологии
note over HIST
  Результаты исследования тканей - отчёты об анализе,
  та же схема, что и у клинических лабораторий тома 3.
end note
@enduml
