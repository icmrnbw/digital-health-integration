Instance: patient-096-mother
InstanceOf: UZCorePatient
Usage: #inline
* language = #en
// The document renderer includes this Patient as both subject and supporting
// resource. An explicit narrative without anchors stays valid in both places.
* text.status = #generated
* text.div = """
<div xmlns="http://www.w3.org/1999/xhtml">
  <p><b>Karimova Dilnoza Akmalovna</b> вЂ” female, born 1994-05-14; alive.</p>
  <p>PINFL: 31234567890123. Health card: HC-096-2026-000123. Local passport: AA1234567.</p>
  <p>Nationality: Uzbek. Marital status: married. Telephone: +998901234567.</p>
  <p>Address: Chilonzor-12, 15-uy, 24-xonadon; postal code 100115; city code 16090011; district code 1726266; state code 1726.</p>
  <p>Managing organization: Toshkent City Perinatal Center.</p>
</div>
"""
* identifier[nationalId].value = "31234567890123"
* identifier[healthCardId].value = "HC-096-2026-000123"
* identifier[passportLocal].value = "AA1234567"
* name.use = #official
* name.text = "Karimova Dilnoza Akmalovna"
* name.family = "Karimova"
* name.given[0] = "Dilnoza"
* name.given[+] = "Akmalovna"
* gender = #female
* birthDate = "1994-05-14"
* extension[nationality].extension[code].valueCodeableConcept = https://terminology.dhp.uz/fhir/core/CodeSystem/nationality-cs#44
* maritalStatus = $v3-MaritalStatus#M
* telecom[0].system = #phone
* telecom[=].value = "+998901234567"
* address[uzAddress].postalCode = "100115"
* address[uzAddress].district = "1726266"
* address[uzAddress].state = "1726"
* address[uzAddress].city = "16090011"
* address[uzAddress].line[0] = "Chilonzor-12"
* address[uzAddress].line[+] = "15-uy, 24-xonadon"
* deceasedBoolean = false
* managingOrganization = Reference(urn:uuid:09600004-1111-2222-3333-444444444444)


