CodeSystem: ScreeningSpecialTreatmentTypeCS
Id: screening-special-treatment-type-cs
Title: "Screening Special Treatment Type CodeSystem"
Description: "Special treatment types recorded when registering a breast or cervical pathology request."
* insert OriginalCodeSystemDraft(screening-special-treatment-type-cs)

* #scrn-0086-00001 "Operativ davolash"
  * ^designation[0].language = #ru
  * ^designation[=].value = "Оперативное"
  * ^designation[+].language = #en
  * ^designation[=].value = "Surgical treatment"
* #scrn-0086-00002 "Kimyoterapiya"
  * ^designation[0].language = #ru
  * ^designation[=].value = "Химиотерапия"
  * ^designation[+].language = #en
  * ^designation[=].value = "Chemotherapy"
* #scrn-0086-00003 "Nurlantirish terapiyasi"
  * ^designation[0].language = #ru
  * ^designation[=].value = "Лучевая терапия"
  * ^designation[+].language = #en
  * ^designation[=].value = "Radiation therapy"
* #scrn-0086-00004 "Immuno-target terapiya"
  * ^designation[0].language = #ru
  * ^designation[=].value = "Иммуно-таргетная терапия"
  * ^designation[+].language = #en
  * ^designation[=].value = "Immuno-targeted therapy"
* #scrn-0086-00005 "Gormonal terapiya"
  * ^designation[0].language = #ru
  * ^designation[=].value = "Гормональная терапия"
  * ^designation[+].language = #en
  * ^designation[=].value = "Hormonal therapy"
* #scrn-0086-00006 "Palliativ davolash"
  * ^designation[0].language = #ru
  * ^designation[=].value = "Паллиативное"
  * ^designation[+].language = #en
  * ^designation[=].value = "Palliative treatment"
* #scrn-0086-00007 "Simptomatik davolash"
  * ^designation[0].language = #ru
  * ^designation[=].value = "Симптоматическое"
  * ^designation[+].language = #en
  * ^designation[=].value = "Symptomatic treatment"
* #scrn-0086-00008 "Boshqa"
  * ^designation[0].language = #ru
  * ^designation[=].value = "Другое"
  * ^designation[+].language = #en
  * ^designation[=].value = "Other"
