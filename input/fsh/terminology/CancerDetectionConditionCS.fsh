CodeSystem: CancerDetectionConditionCS
Id: cancer-detection-condition-cs
Title: "Cancer Detection Condition translation in Russian and English"
Description: "Cancer detection condition code system for Uzbekistan healthcare system"
* insert OriginalCodeSystemDraft(cancer-detection-condition-cs)

* #cancer-0005-0001 "Mustaqil ravishda murojaat qilgan"
  * ^designation[0].language = #ru
  * ^designation[=].value = "Обратился самостоятельно"
  * ^designation[+].language = #en
  * ^designation[=].value = "Self-referred"

* #cancer-0005-0002 "Onkonazorat kabinetida aniqlangan"
  * ^designation[0].language = #ru
  * ^designation[=].value = "Выявлен в кабинете Онконазорат"
  * ^designation[+].language = #en
  * ^designation[=].value = "Detected in the Onconazorat office"

* #cancer-0005-0003 "Boshqa turdagi profilaktik ko‘riklarda aniqlangan"
  * ^designation[0].language = #ru
  * ^designation[=].value = "При других видах профосмотра"
  * ^designation[+].language = #en
  * ^designation[=].value = "Detected during other types of preventive examinations"

* #cancer-0005-0004 "Parallel profilaktik ko‘rik vaqtida aniqlangan"
  * ^designation[0].language = #ru
  * ^designation[=].value = "При параллельном профосмотре"
  * ^designation[+].language = #en
  * ^designation[=].value = "Detected during a concurrent preventive examination"

* #cancer-0005-0005 "Skrining vaqtida aniqlangan"
  * ^designation[0].language = #ru
  * ^designation[=].value = "При скрининге"
  * ^designation[+].language = #en
  * ^designation[=].value = "Detected during screening"

* #cancer-0005-0006 "Hayotligida aniqlangan tashxis bilan vafotidan keyin hisobga olingan"
  * ^designation[0].language = #ru
  * ^designation[=].value = "Учтен посмертно с диагнозом, установленом при жизни"
  * ^designation[+].language = #en
  * ^designation[=].value = "Registered posthumously with a diagnosis established during life"

* #cancer-0005-0007 "Otopsiyasiz vafotidan keyin hisobga olingan"
  * ^designation[0].language = #ru
  * ^designation[=].value = "Учтен посмертно без вскрытия"
  * ^designation[+].language = #en
  * ^designation[=].value = "Registered posthumously without an autopsy"

* #cancer-0005-0008 "Otopsiyadan keyin vafotidan so‘ng hisobga olingan"
  * ^designation[0].language = #ru
  * ^designation[=].value = "Учтен посмертно после вскрытия"
  * ^designation[+].language = #en
  * ^designation[=].value = "Registered posthumously after an autopsy"


