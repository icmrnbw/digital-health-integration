CodeSystem: BallardBreastMaturityCS
Id: ballard-breast-maturity-cs
Title: "Form097 Ballard Breast Maturity"
Description: "Local codes for ballard breast maturity, Form097 newborn development record."

* insert OriginalCodeSystemDraft(ballard-breast-maturity-cs)

* #chr-0110-0001 "-1: to'qima aniqlanmaydi"
  * ^designation[0].language = #ru
  * ^designation[=].value = "-1: ткань не определяется"
  * ^designation[+].language = #en
  * ^designation[=].value = "-1: imperceptible"

* #chr-0110-0002 "0: to'qima zo'rg'a aniqlanadi"
  * ^designation[0].language = #ru
  * ^designation[=].value = "0: едва определяется"
  * ^designation[+].language = #en
  * ^designation[=].value = "0: barely perceptible"

* #chr-0110-0003 "1: areola yassi, kurtak yo'q"
  * ^designation[0].language = #ru
  * ^designation[=].value = "1: ареола плоская, сосок отсутствует"
  * ^designation[+].language = #en
  * ^designation[=].value = "1: flat areola, no bud"

* #chr-0110-0004 "2: areola donador, kurtak 1-2 mm"
  * ^designation[0].language = #ru
  * ^designation[=].value = "2: ареола припухшая, ткань 1-2 мм"
  * ^designation[+].language = #en
  * ^designation[=].value = "2: stippled areola, 1-2 mm bud"

* #chr-0110-0005 "3: areola ko'tarilgan, kurtak 3-4 mm"
  * ^designation[0].language = #ru
  * ^designation[=].value = "3: ареола приподнята, ткань 3-4 мм"
  * ^designation[+].language = #en
  * ^designation[=].value = "3: raised areola, 3-4 mm bud"

* #chr-0110-0006 "4: areola to'liq, kurtak 5-10 mm"
  * ^designation[0].language = #ru
  * ^designation[=].value = "4: полная ареола, ткань 5-10 мм"
  * ^designation[+].language = #en
  * ^designation[=].value = "4: full areola, 5-10 mm bud"