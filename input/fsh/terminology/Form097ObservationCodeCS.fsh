  * ^designation[0].language = #ru
  * ^designation[=].value = "Подколенный угол"
  * ^designation[+].language = #en
  * ^designation[=].value = "Popliteal angle"

* #eye-position "Ko'zlar holati"
  * ^designation[0].language = #ru
  * ^designation[=].value = "Положение глаз"
  * ^designation[+].language = #en
  * ^designation[=].value = "Eye position"

* #silverman-severity "Silverman shkalasi bo'yicha nafas yetishmovchiligi darajasi"
  * ^designation[0].language = #ru
