CodeSystem: Form096SnomedSupplementCS
Id: form096-snomed-supplement-cs
Title: "Form 096 SNOMED CT Displays"
Description: "Uzbek and Russian displays for the SNOMED CT codes that replace Form 096 local codes"

* insert SupplementCodeSystemDraft(form096-snomed-supplement-cs, $sct, 0.11.1)

* #249063009 "Longitudinal lie"
  * ^designation[0].language = #ru
  * ^designation[=].value = "Продольное"
  * ^designation[+].language = #uz
  * ^designation[=].value = "Uzunasiga"

