CodeSystem: CancerCCpMCategoryCS
Id: cancer-cc-p-m-category-cs
Title: "Cancer CCpM Category translation in Russian and English"
Description: "Cancer CCpM category code system for Uzbekistan healthcare system"
* insert OriginalCodeSystemDraft(cancer-cc-p-m-category-cs)

* #cancer-0011-0001 "X"
  * ^designation[0].language = #ru
  * ^designation[=].value = "X"
  * ^designation[+].language = #en
  * ^designation[=].value = "X"

* #cancer-0011-0002 "0"
  * ^designation[0].language = #ru
  * ^designation[=].value = "0"
  * ^designation[+].language = #en
  * ^designation[=].value = "0"