  * ^designation[=].value = "Физическая подготовка к родам"

* #chr-0025-00003 "Psixoprofilaktik tayyorgarlik"
  * ^designation[0].language = #en
  * ^designation[=].value = "Psychoprophylactic preparation"
  * ^designation[+].language = #ru
  * ^designation[=].value = "Психопрофилактическая подготовка"

* #chr-0025-00004 "Ultrabinafsha nurlanish"
