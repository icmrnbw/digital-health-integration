CodeSystem: ScreeningColposcopyCS
Id: screening-colposcopy-cs
Title: "Colposcopy Results CodeSystem"
Description: "Local terminology for colposcopy examination results"
* insert OriginalCodeSystemDraft(screening-colposcopy-cs)

* #scrn-0091-00001 "Norma (NILM)"
  * ^designation[0].language = #ru
  * ^designation[=].value = "Норма (NILM)"
  * ^designation[+].language = #en
  * ^designation[=].value = "NILM (Normal)"

* #scrn-0091-00002 "LSIL"
  * ^designation[0].language = #ru
  * ^designation[=].value = "LSIL"
  * ^designation[+].language = #en
  * ^designation[=].value = "LSIL"

* #scrn-0091-00003 "HSIL"
  * ^designation[0].language = #ru
  * ^designation[=].value = "HSIL"
  * ^designation[+].language = #en
  * ^designation[=].value = "HSIL"

* #scrn-0091-00004 "Atipik o'zgarish"
  * ^designation[0].language = #ru
  * ^designation[=].value = "Атипичное изменение"
  * ^designation[+].language = #en
  * ^designation[=].value = "Atypical"

* #scrn-0091-00005 "ASC-H" "Atypical squamous cells, cannot exclude high-grade squamous intraepithelial lesion, as recorded in the Screening conclusion."
  * ^designation[0].language = #ru
  * ^designation[=].value = "ASC-H (атипичные клетки плоского эпителия, нельзя исключить HSIL)"
  * ^designation[+].language = #en
  * ^designation[=].value = "ASC-H (atypical squamous cells, cannot exclude HSIL)"

* #scrn-0091-00006 "Bachadon bo'yni intraepitelial neoplaziyasi 1-daraja (CIN 1)" "Cervical intraepithelial neoplasia grade 1, as recorded in the Screening conclusion."
  * ^designation[0].language = #ru
  * ^designation[=].value = "Цервикальная интраэпителиальная неоплазия 1 степени (CIN 1)"
  * ^designation[+].language = #en
  * ^designation[=].value = "Cervical intraepithelial neoplasia grade 1 (CIN 1)"

* #scrn-0091-00007 "Bachadon bo'yni intraepitelial neoplaziyasi 2-daraja yoki og'irroq (CIN 2+)" "The combined cervical intraepithelial neoplasia grade 2 or worse (CIN 2+) conclusion category; no specific higher grade is inferred."
  * ^designation[0].language = #ru
  * ^designation[=].value = "Цервикальная интраэпителиальная неоплазия 2 степени и выше (CIN 2+)"
  * ^designation[+].language = #en
  * ^designation[=].value = "Cervical intraepithelial neoplasia grade 2 or worse (CIN 2+)"
