CodeSystem: Form111_AnalysisTestCodeCS
Id: form111-analysis-test-code-cs
Title: "Form 111 Analysis Test Code"
Description: "Form 111 Analysis Test Code for clinical documents and other knowledge resources in Uzbekistan integrations. Based on Ministry of Health Order 399."
* insert OriginalCodeSystemDraft(form111-analysis-test-code-cs)

* #chr-0001-00001 "Gonokokk"
  * ^designation[0].language = #en
  * ^designation[=].value = "Gonococcus test"
  * ^designation[+].language = #ru
  * ^designation[=].value = "Гонококк"

* #chr-0001-00006 "Boshqa tahlil"
  * ^designation[0].language = #en
  * ^designation[=].value = "Other analysis"
  * ^designation[+].language = #ru
  * ^designation[=].value = "Другой анализ"
