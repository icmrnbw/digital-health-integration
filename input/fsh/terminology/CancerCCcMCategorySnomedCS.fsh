CodeSystem: CancerCCcMCategorySnomedCS
Id: cancer-ccc-m-category-snomed-cs
Title: "Cancer CCC M Category SNOMED CT Supplement"
Description: "SNOMED CT supplement containing Uzbek and Russian designations for cancer CCC M category concepts used in the Uzbekistan healthcare system."

* insert SupplementCodeSystemDraft(
    cancer-ccc-m-category-snomed-cs,
    $sct,
    2026.1.0
)

* #1352512001 "0"
  * ^designation[0].language = #ru
  * ^designation[=].value = "0"
  * ^designation[+].language = #uz
  * ^designation[=].value = "0"

* #1352513006 "1"
  * ^designation[0].language = #ru
  * ^designation[=].value = "1"
  * ^designation[+].language = #uz
  * ^designation[=].value = "1"

* #1352517007 "1a"
  * ^designation[0].language = #ru
  * ^designation[=].value = "1a"
  * ^designation[+].language = #uz
  * ^designation[=].value = "1a"

* #1352514000 "1b"
  * ^designation[0].language = #ru
  * ^designation[=].value = "1b"
  * ^designation[+].language = #uz
  * ^designation[=].value = "1b"

* #1352516003 "1c"
  * ^designation[0].language = #ru
  * ^designation[=].value = "1c"
  * ^designation[+].language = #uz
  * ^designation[=].value = "1c"

* #1352510009 "1d"
