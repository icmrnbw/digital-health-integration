CodeSystem: Form111_ObstetricHistoryFactorCS
Id: form111-obstetric-history-factor-cs
Title: "Form 111 Obstetric History Factor Code"
Description: "Form 111 Obstetric History Factor Code for clinical documents and other knowledge resources in Uzbekistan integrations. Based on Ministry of Health Order 399."
* insert OriginalCodeSystemDraft(form111-obstetric-history-factor-cs)

* #chr-0019-00001 "Bakterial yoki virusli ginekologik kasalliklar"
  * ^designation[0].language = #en
  * ^designation[=].value = "Bacterial or viral gynecological diseases"
  * ^designation[+].language = #ru
  * ^designation[=].value = "Бактериальные или вирусные гинекологические заболевания"

* #chr-0019-00002 "Genetik kasallik yoki rivojlanish anomaliyasi bo'lgan bola tug'ilishi"
  * ^designation[0].language = #en
  * ^designation[=].value = "Child with genetic disease or developmental anomaly"
  * ^designation[+].language = #ru
  * ^designation[=].value = "Рождение ребенка с генетическим заболеванием или аномалией развития"

* #chr-0019-00003 "Vazni past yoki yuqori bola tug'ilishi"
  * ^designation[0].language = #en
  * ^designation[=].value = "Birth of a child with low or high weight"
  * ^designation[+].language = #ru
  * ^designation[=].value = "Рождение ребенка с низким или высоким весом"

* #chr-0019-00004 "Avvalgi homiladorlikning asoratli kechishi"
  * ^designation[0].language = #en
  * ^designation[=].value = "Complicated course of previous pregnancy"
  * ^designation[+].language = #ru
  * ^designation[=].value = "Осложненное течение предыдущей беременности"

* #chr-0019-00005 "To'rt va undan ortiq tug'ruq"
  * ^designation[0].language = #en
  * ^designation[=].value = "Four or more deliveries"
  * ^designation[+].language = #ru
  * ^designation[=].value = "Четыре и более родов"

* #chr-0019-00006 "Bepushtlik"
  * ^designation[0].language = #en
  * ^designation[=].value = "Infertility"
  * ^designation[+].language = #ru
  * ^designation[=].value = "Бесплодие"

* #chr-0019-00007 "Ko'p yoki asoratlangan abortlar"
  * ^designation[0].language = #en
  * ^designation[=].value = "Multiple or complicated abortions"
  * ^designation[+].language = #ru
  * ^designation[=].value = "Множественные или осложненные аборты"

* #chr-0019-00008 "Neonatal o'lim"
  * ^designation[0].language = #en
  * ^designation[=].value = "Neonatal death"
  * ^designation[+].language = #ru
  * ^designation[=].value = "Неонатальная смерть"

* #chr-0019-00009 "Rivojlanmayotgan homiladorlik"
  * ^designation[0].language = #en
  * ^designation[=].value = "Non-developing pregnancy"
  * ^designation[+].language = #ru
  * ^designation[=].value = "Неразвивающаяся беременность"

* #chr-0019-00010 "Homiladorlikni yo'qotish"
  * ^designation[0].language = #en
  * ^designation[=].value = "Pregnancy loss"
  * ^designation[+].language = #ru
  * ^designation[=].value = "Потеря беременности"

* #chr-0019-00011 "Муддатидан олдин туғруқ"
  * ^designation[0].language = #en
  * ^designation[=].value = "Premature birth"
  * ^designation[+].language = #ru
  * ^designation[=].value = "Преждевременные роды"

* #chr-0019-00012 "Ўлик туғилиш"
  * ^designation[0].language = #en
  * ^designation[=].value = "Stillbirth"
  * ^designation[+].language = #ru
  * ^designation[=].value = "Мертворождение"

* #chr-0019-00013 "Bachadon yoki qo'shimchalarda operatsiya"
