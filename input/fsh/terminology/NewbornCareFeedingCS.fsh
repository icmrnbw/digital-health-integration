CodeSystem: NewbornCareFeedingCS
Id: newborn-care-feeding-cs
Title: "Form097 Newborn Care And Feeding"
Description: "Local codes for newborn care and feeding, Form097 newborn development record."

* insert OriginalCodeSystemDraft(newborn-care-feeding-cs)

* #chr-0124-0001 "Emizilmaslik sababi: ona holati"
  * ^designation[0].language = #ru
  * ^designation[=].value = "Причина отсутствия грудного вскармливания: состояние матери"
  * ^designation[+].language = #en
  * ^designation[=].value = "Reason for not breastfeeding: maternal condition"

* #chr-0124-0002 "Emizilmaslik sababi: bola holati"
  * ^designation[0].language = #ru
  * ^designation[=].value = "Причина отсутствия грудного вскармливания: состояние ребёнка"
  * ^designation[+].language = #en
  * ^designation[=].value = "Reason for not breastfeeding: infant condition"

* #chr-0124-0003 "Neonatal audiologik skrining"
  * ^designation[0].language = #ru
  * ^designation[=].value = "Неонатальный аудиологический скрининг"
  * ^designation[+].language = #en
  * ^designation[=].value = "Neonatal audiological screening"

* #chr-0124-0004 "Tug'ma gipotireoz uchun neonatal skrining"
  * ^designation[0].language = #ru
  * ^designation[=].value = "Неонатальный скрининг на врождённый гипотиреоз"
  * ^designation[+].language = #en
  * ^designation[=].value = "Neonatal screening for congenital hypothyroidism"

* #chr-0124-0005 "Ona va chaqaloqning bir xonada bo'lishi"
  * ^designation[0].language = #ru
  * ^designation[=].value = "Совместное пребывание матери и ребёнка"
  * ^designation[+].language = #en
  * ^designation[=].value = "Rooming-in of mother and newborn"

* #chr-0124-0006 "Ona va chaqaloqni tug'ruqdan keyin birga ko'chirish"
  * ^designation[0].language = #ru
  * ^designation[=].value = "Совместный перевод матери и ребёнка после родов"
  * ^designation[+].language = #en
  * ^designation[=].value = "Postpartum transfer of mother and newborn together"

* #chr-0124-0007 "Chaqaloqni onaga topshirishgacha bo'lgan vaqt"
  * ^designation[0].language = #ru
  * ^designation[=].value = "Время до передачи ребёнка матери"
  * ^designation[+].language = #en
  * ^designation[=].value = "Time until newborn was handed to mother"