CodeSystem: BallardSkinMaturityCS
Id: ballard-skin-maturity-cs
Title: "Form097 Ballard Skin Maturity"
Description: "Local codes for ballard skin maturity, Form097 newborn development record."

* insert OriginalCodeSystemDraft(ballard-skin-maturity-cs)

* #chr-0107-0001 "-1: yopishqoq, shaffof, oson yirtiladi"
  * ^designation[0].language = #ru
  * ^designation[=].value = "-1: липкая, прозрачная, легко рвётся"
  * ^designation[+].language = #en
  * ^designation[=].value = "-1: sticky, friable, transparent"

* #chr-0107-0002 "0: jelatinsimon, qizil, yarim shaffof"
  * ^designation[0].language = #ru
  * ^designation[=].value = "0: желатинозная, красная, просвечивающая"
  * ^designation[+].language = #en
  * ^designation[=].value = "0: gelatinous, red, translucent"

* #chr-0107-0003 "1: silliq pushti, venalar ko'rinadi"
  * ^designation[0].language = #ru
  * ^designation[=].value = "1: розовая, видны вены"
  * ^designation[+].language = #en
  * ^designation[=].value = "1: smooth pink, visible veins"

* #chr-0107-0004 "2: yuzaki po'st tashlash/toshma, venalar kam"
  * ^designation[0].language = #ru
  * ^designation[=].value = "2: поверхностное шелушение/сыпь, немного вен"
  * ^designation[+].language = #en
  * ^designation[=].value = "2: superficial peeling/rash, few veins"

* #chr-0107-0005 "3: yoriqlar, rangpar joylar, venalar siyrak"
  * ^designation[0].language = #ru
  * ^designation[=].value = "3: растрескивание, бледные участки, редкие вены"
  * ^designation[+].language = #en
  * ^designation[=].value = "3: cracking, pale areas, rare veins"

* #chr-0107-0006 "4: pergamentsimon, chuqur yoriqlar, tomirlar yo'q"
  * ^designation[0].language = #ru
  * ^designation[=].value = "4: пергаментная, глубокие трещины, вен нет"
  * ^designation[+].language = #en
  * ^designation[=].value = "4: parchment-like, deep cracking, no vessels"