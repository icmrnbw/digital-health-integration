CodeSystem: CancerSpecialTreatmentCS
Id: cancer-special-treatment-cs
Title: "Cancer special treatment translation in Russian and English"
Description: "Cancer special treatment code system for Uzbekistan healthcare system"
* insert OriginalCodeSystemDraft(cancer-special-treatment-cs)

* #cancer-0018-0001 "O‘tkazilmagan"
  * ^designation[0].language = #ru
  * ^designation[=].value = "Не проводилось"
  * ^designation[+].language = #en
  * ^designation[=].value = "Not performed"

* #cancer-0018-0002 "Jarrohlik davolash"
  * ^designation[0].language = #ru
  * ^designation[=].value = "Хирургическое"
  * ^designation[+].language = #en
  * ^designation[=].value = "Surgical treatment"

* #cancer-0018-0003 "Masofaviy nur terapiyasi"
  * ^designation[0].language = #ru
  * ^designation[=].value = "Дистанционная лучевая терапия"
  * ^designation[+].language = #en
  * ^designation[=].value = "External beam radiation therapy"

* #cancer-0018-0004 "Qisqa fokusli rentgenoterapiya"
  * ^designation[0].language = #ru
  * ^designation[=].value = "Короткофокусная рентгенотерапия"
  * ^designation[+].language = #en
  * ^designation[=].value = "Short-focus X-ray therapy"

* #cancer-0018-0005 "Qo‘shma nur terapiyasi: kontakt + masofaviy nur terapiyasi"
  * ^designation[0].language = #ru
  * ^designation[=].value = "Сочетанное лучевое: конт.+дистанц."
  * ^designation[+].language = #en
  * ^designation[=].value = "Combined radiation therapy: contact + external beam radiation therapy"

* #cancer-0018-0006 "Qo‘shma nur terapiyasi: kontakt + rentgenoterapiya"
  * ^designation[0].language = #ru
  * ^designation[=].value = "Сочетанное лучевое: конт.+рентген."
  * ^designation[+].language = #en
  * ^designation[=].value = "Combined radiation therapy: contact + X-ray therapy"

* #cancer-0018-0007 "Kimyoterapiya (gormonal terapiya)"
  * ^designation[0].language = #ru
  * ^designation[=].value = "Химиотерапевтическое (гормональное)"
  * ^designation[+].language = #en
  * ^designation[=].value = "Chemotherapy (hormonal therapy)"

* #cancer-0018-0008 "Jarrohlik davolash + masofaviy nur terapiyasi"
  * ^designation[0].language = #ru
  * ^designation[=].value = "Хирургическое+дистанц.лучевая терапия"
  * ^designation[+].language = #en
  * ^designation[=].value = "Surgery + external beam radiation therapy"

* #cancer-0018-0009 "Jarrohlik davolash + qisqa fokusli rentgenoterapiya"
  * ^designation[0].language = #ru
  * ^designation[=].value = "Хирургическое+короткофок.рентгенотерапия"
  * ^designation[+].language = #en
  * ^designation[=].value = "Surgery + short-focus X-ray therapy"

* #cancer-0018-0010 "Jarrohlik davolash + qo‘shma nur terapiyasi"
  * ^designation[0].language = #ru
  * ^designation[=].value = "Хирургическое+сочетанная лучевая терапия"
  * ^designation[+].language = #en
  * ^designation[=].value = "Surgery + combined radiation therapy"

* #cancer-0018-0011 "Jarrohlik davolash + kontakt nur terapiyasi"
  * ^designation[0].language = #ru
  * ^designation[=].value = "Хирургическое+контактная лучевая терапия"
  * ^designation[+].language = #en
  * ^designation[=].value = "Surgery + contact radiation therapy"

* #cancer-0018-0012 "Jarrohlik davolash + kimyoterapiya (gormonal terapiya)"
  * ^designation[0].language = #ru
  * ^designation[=].value = "Хирургическое+химиотерапия (гормонотерапия)"
  * ^designation[+].language = #en
  * ^designation[=].value = "Surgery + chemotherapy (hormonal therapy)"

* #cancer-0018-0013 "Kompleks kimyo-nur terapiyasi"
  * ^designation[0].language = #ru
  * ^designation[=].value = "Комплексная химиолучевая терапия"
  * ^designation[+].language = #en
  * ^designation[=].value = "Combined chemoradiotherapy"

* #cancer-0018-0014 "Jarrohlik davolash + nur terapiyasi + kimyoterapiya (gormonal terapiya)"
  * ^designation[0].language = #ru
  * ^designation[=].value = "Хирургичекое+ лучевое+химиотерапия (гормонотерапия)"
  * ^designation[+].language = #en
  * ^designation[=].value = "Surgery + radiation therapy + chemotherapy (hormonal therapy)"

* #cancer-0018-0015 "Radiofarmatsevtik preparatlar"
  * ^designation[0].language = #ru
  * ^designation[=].value = "Радиофармпрепараты"
  * ^designation[+].language = #en
  * ^designation[=].value = "Radiopharmaceuticals"

* #cancer-0018-0016 "Kontakt nur terapiyasi"
  * ^designation[0].language = #ru
  * ^designation[=].value = "Контактная лучевая терапия"
  * ^designation[+].language = #en
  * ^designation[=].value = "Contact radiation therapy"

* #cancer-0018-0017 "Boshqa davolash usullari"
  * ^designation[0].language = #ru
  * ^designation[=].value = "Другие виды воздействия"
  * ^designation[+].language = #en
  * ^designation[=].value = "Other treatment modalities"

* #cancer-0018-0018 "Jarrohlik davolash + radiofarmatsevtik preparatlar"
  * ^designation[0].language = #ru
  * ^designation[=].value = "Хирургическое+радиофармпрепараты"
  * ^designation[+].language = #en
  * ^designation[=].value = "Surgery + radiopharmaceuticals"

* #cancer-0018-0019 "Qo‘shma nur terapiyasi: masofaviy nur terapiyasi + rentgenoterapiya"
  * ^designation[0].language = #ru
  * ^designation[=].value = "Сочетанное лучевое:дистанционная лучевая терапия+рентгентерапия"
  * ^designation[+].language = #en
  * ^designation[=].value = "Combined radiation therapy: external beam radiation therapy + X-ray therapy"


