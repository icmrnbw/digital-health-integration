CodeSystem: CancerConfirmationMethodCS
Id: cancer-confirmation-method-cs
Title: "Cancer Confirmation Method translation in Russian and English"
Description: "Cancer confirmation method code system for Uzbekistan healthcare system"
* insert OriginalCodeSystemDraft(cancer-confirmation-method-cs)

* #cancer-0002-0001 "Spetsifik o‘sma markerlari"
  * ^designation[0].language = #ru
  * ^designation[=].value = "Специфические опухолевые маркёры"
  * ^designation[+].language = #en
  * ^designation[=].value = "Specific tumor markers"

* #cancer-0002-0002 "Sitologik usulda (immunofenotiplash)"
  * ^designation[0].language = #ru
  * ^designation[=].value = "Цитологически (Иммунофенотипировние)"
  * ^designation[+].language = #en
  * ^designation[=].value = "Cytology (immunophenotyping)"

* #cancer-0002-0003 "Gistologiya"
  * ^designation[0].language = #ru
  * ^designation[=].value = "Гистология"
  * ^designation[+].language = #en
  * ^designation[=].value = "Histology"

* #cancer-0002-0004 "Sitogenetika va/yoki molekulyar diagnostika"
  * ^designation[0].language = #ru
  * ^designation[=].value = "Цитогенетика и/или молекулярная диагностика"
  * ^designation[+].language = #en
  * ^designation[=].value = "Cytogenetics and/or molecular diagnostics"

* #cancer-0002-0005 "Faqat o‘lim haqidagi guvohnoma (DCO)"
  * ^designation[0].language = #ru
  * ^designation[=].value = "Только свидетельство о смерти (DCO)"
  * ^designation[+].language = #en
  * ^designation[=].value = "Death certificate only (DCO)"

* #cancer-0002-0006 "Faqat klinik jihatdan (instrumental tekshiruvlarsiz)"
  * ^designation[0].language = #ru
  * ^designation[=].value = "Только клинически (без инстурументального исследования)"
  * ^designation[+].language = #en
  * ^designation[=].value = "Clinical diagnosis only (without instrumental examination)"

* #cancer-0002-0007 "Instrumental tekshiruv usullari"
  * ^designation[0].language = #ru
  * ^designation[=].value = "Инструментальные методы"
  * ^designation[+].language = #en
  * ^designation[=].value = "Instrumental diagnostic methods"


